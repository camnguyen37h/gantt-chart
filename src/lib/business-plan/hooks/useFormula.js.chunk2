      }).value
    )
  }
  const getIncentivesRateCell = makeRefCrossViewFn(ROWS.INCENTIVES_RATE)
  const getProductionMMBonusCell = makeRefCrossViewFn(ROWS.PRODUCTION_MM_BONUS)
  const getBillRateNormCell = makeRefCrossViewFn(ROWS.BILL_RATE_NORM)
  const hideInOB = fn => args => fn(args)
  const obOnly = fn => args => null
  const FORMULA_CONFIG = {
    MAN_MONTH: {
      UNIT_PRICE: {
