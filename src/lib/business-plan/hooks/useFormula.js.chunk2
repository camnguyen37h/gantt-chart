      }).value
    )
  }
  const getEfficiencyTotal = ({ targetItem }) => {
    if (viewMode === VIEWS.TOTAL) return sumCrossViewTotals(SECTIONS.REFERENCE, ROWS.EFFICIENCY)
    const dmItem = getItem({
